# Project Root Environment Template
# Refer to server/.env.example and client/.env.example for specific module settings.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/inventory_app?retryWrites=true&w=majority
CLIENT_URL=https://your-frontend.vercel.app
VITE_API_URL=https://your-backend.onrender.com/api
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

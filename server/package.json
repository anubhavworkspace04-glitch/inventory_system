{
  "name": "inventory-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc && concurrently \"tsc -w\" \"node --watch dist/server.js\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "node --loader ts-node/esm src/config/seed.ts",
    "migrate:stock": "node --loader ts-node/esm src/config/migrateStock.ts",
    "migrate:payments": "node --loader ts-node/esm src/config/migratePayments.ts",
    "reconcile:payments": "node --loader ts-node/esm src/config/reconcilePayments.ts",
    "reconcile:customers": "node --loader ts-node/esm src/config/reconcilePayments.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "inventory-app-root": "file:..",
    "mongoose": "^8.5.3",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}

# Server Environment Variables Configuration Template
NODE_ENV=production
PORT=5000

# MongoDB Production Connection String (MongoDB Atlas M0)
# Replace placeholders with your Atlas application user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/inventory_app?retryWrites=true&w=majority

# JWT & Session Secret Key
JWT_SECRET=your_production_jwt_secret_key_change_in_production

# CORS Allowed Origin (Vercel Frontend URL)
CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary Storage Credentials (Server-Side Only - DO NOT EXPOSE TO FRONTEND)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
